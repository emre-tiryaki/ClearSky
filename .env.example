# RabbitMQ
RABBITMQ_USER=clear_sky
RABBITMQ_PASSWORD=degistir_beni
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=flight-events

# MongoDB 
MONGO_USER=clear_sky
MONGO_PASSWORD=degistir_beni
MONGO_PORT=27017

# device-interface 
OPENSKY_BASE_URL=https://opensky-network.org/api
POLL_INTERVAL_MS=15000
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# api-gateway 
PORT=4000
API_GATEWAY_PORT=4000
RABBITMQ_QUEUE=api-gateway-flight-queue
RABBITMQ_ROUTING_PATTERN=flight.position.*
RABBITMQ_PREFETCH=20
RABBITMQ_STATUS_QUEUE=api-gateway-status-queue
RABBITMQ_STATUS_ROUTING_PATTERN=system.status
GRAPHIQL_ENABLED=true
MONGODB_DB_NAME=clearsky

# frontend 
FRONTEND_PORT=8080
VITE_GRAPHQL_WS_URL=ws://localhost:4000/graphql
VITE_GRAPHQL_HTTP_URL=http://localhost:4000/graphql